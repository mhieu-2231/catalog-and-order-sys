@model IEnumerable<Catalog_And_Order_Sys.Models.Product>
@{
    ViewData["Title"] = "Trang chủ";
}

<!-- Cam kết -->
<section class="top-discount-area d-md-flex align-items-center">
    <div class="single-discount-area">
        <h5>Hàng chính hãng 100%</h5>
        <h6>Bảo hành 12 tháng</h6>
    </div>
    <div class="single-discount-area">
        <h5>Giao hàng toàn quốc</h5>
        <h6>Nhanh chóng, miễn phí</h6>
    </div>
    <div class="single-discount-area">
        <h5>Đổi trả trong 7 ngày</h5>
        <h6>Nếu có lỗi từ nhà sản xuất</h6>
    </div>
</section>

<!-- Banner -->
<section class="phone-hero d-flex align-items-center">
    <div class="container">
        <h6>Smartphone chính hãng</h6>
        <h2>Tìm chiếc điện thoại<br>dành cho bạn</h2>
        <a asp-controller="Shop" asp-action="Index" class="btn karl-btn">Xem sản phẩm</a>
    </div>
</section>

<!-- Sản phẩm mới -->
<section class="new_arrivals_area section_padding_100_0 clearfix">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="section_heading text-center">
                    <h2>Điện thoại mới về</h2>
                </div>
            </div>
        </div>
    </div>
    <div class="container">
        <div class="row karl-new-arrivals">
            @foreach (var product in Model)
            {
                <div class="col-12 col-sm-6 col-md-4 single_gallery_item">
                    <div class="product-img">
                        <img src="@(product.ImageUrl ?? "/img/product-img/product-1.jpg")" alt="@product.ProductName">
                        <div class="product-quicview">
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@product.ProductId">
                                <i class="ti-plus"></i>
                            </a>
                        </div>
                    </div>
                    <div class="product-description">
                        <h4 class="product-price">@product.Price.ToString("N0") đ</h4>
                        <p>@product.ProductName</p>
                        <a asp-controller="Product" asp-action="Details" asp-route-id="@product.ProductId" class="add-to-cart-btn">XEM CHI TIẾT</a>
                    </div>
                </div>
            }
            @if (!Model.Any())
            {
                <div class="col-12 text-center"><p>Chưa có sản phẩm nào.</p></div>
            }
        </div>
        <div class="text-center mt-30 mb-50">
            <a asp-controller="Shop" asp-action="Index" class="btn karl-btn">Xem tất cả</a>
        </div>
    </div>
</section>