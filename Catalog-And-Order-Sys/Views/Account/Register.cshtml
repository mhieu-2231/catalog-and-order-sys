@{
    ViewData["Title"] = "Đăng ký";
}

<div class="container">
    <div class="tg-auth">
        <h2>Tạo tài khoản</h2>
        <div asp-validation-summary="All" class="text-danger mb-2"></div>

        <form asp-controller="Account" asp-action="Register" method="post">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label>Họ tên</label>
                <input name="fullName" class="form-control" placeholder="Nguyễn Văn A" />
            </div>
            <div class="form-group">
                <label>Email</label>
                <input name="email" type="email" class="form-control" placeholder="email@gmail.com" />
            </div>
            <div class="form-group">
                <label>Mật khẩu</label>
                <input name="password" type="password" class="form-control" />
            </div>
            <div class="form-group">
                <label>Nhập lại mật khẩu</label>
                <input name="confirmPassword" type="password" class="form-control" />
            </div>
            <button type="submit" class="btn karl-btn btn-block">Đăng ký</button>
        </form>

        <p class="tg-auth-foot">Đã có tài khoản? <a asp-action="Login">Đăng nhập</a></p>
    </div>
</div>