@{
    Layout = null; // Trang login độc lập
    ViewData["Title"] = "Đăng nhập";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - MobileShop</title>
    <link href="~/admin/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #f3f5f8; }
        .login-panel { border-radius: 12px; overflow: hidden; box-shadow: 0 6px 24px rgba(0,0,0,.08); }
        .login-panel .panel-heading { background: #1a73e8; color: #fff; border: 0; padding: 16px 20px; }
        .login-panel .panel-title { font-weight: 700; font-size: 18px; }
        .btn-login { background: #1a73e8; border-color: #1a73e8; color: #fff; }
        .btn-login:hover, .btn-login:focus { background: #0b57c9; border-color: #0b57c9; color: #fff; }
        .login-divider { text-align: center; color: #999; margin: 18px 0 12px; font-size: 13px; }
        .btn-register { background: #fff; border: 1px solid #1a73e8; color: #1a73e8; font-weight: 600; }
        .btn-register:hover { background: #f0f6ff; color: #1a73e8; }
        .login-back { text-align: center; margin-top: 14px; }
        .login-back a { color: #707070; }
    </style>
</head>
<body>
    <div class="container" style="margin-top:80px;">
        <div class="row">
            <div class="col-md-4 col-md-offset-4">
                <div class="login-panel panel panel-default">
                    <div class="panel-heading">
                        <h3 class="panel-title">Đăng nhập</h3>
                    </div>
                    <div class="panel-body">
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger">
                                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <p>@err.ErrorMessage</p>
                                }
                            </div>
                        }

                        <form asp-controller="Account" asp-action="Login" method="post">
                            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                            <div class="form-group">
                                <input class="form-control" placeholder="Email" name="email" type="email" autofocus>
                            </div>
                            <div class="form-group">
                                <input class="form-control" placeholder="Mật khẩu" name="password" type="password">
                            </div>
                            <button type="submit" class="btn btn-lg btn-login btn-block">Đăng nhập</button>
                        </form>

                        <div class="login-divider">Chưa có tài khoản?</div>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-lg btn-register btn-block">Đăng ký tài khoản</a>

                        <div class="login-back">
                            <a asp-controller="Home" asp-action="Index">&larr; Về trang chủ</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>