@model Catalog_And_Order_Sys.Models.Product
@{
    ViewData["Title"] = Model.ProductName;
}

<div class="container">
    <div class="row">
        <div class="col-12">
            <ol class="breadcrumb d-flex align-items-center">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                <li class="breadcrumb-item">
                    <a asp-controller="Shop" asp-action="Index" asp-route-categoryId="@Model.CategoryId">@Model.Category?.CategoryName</a>
                </li>
                <li class="breadcrumb-item active">@Model.ProductName</li>
            </ol>
            <a asp-controller="Shop" asp-action="Index" class="backToHome d-block">
                <i class="fa fa-angle-double-left"></i> Quay lại danh sách
            </a>
        </div>
    </div>
</div>

<section class="single_product_details_area section_padding_0_100">
    <div class="container">
        <div class="row">
            <div class="col-12 col-md-6">
                <div class="single_product_thumb">
                    <img class="d-block w-100" src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/img/product-img/product-9.jpg" : Model.ImageUrl)" alt="@Model.ProductName">
                </div>
            </div>

            <div class="col-12 col-md-6">
                <div class="single_product_desc">
                    <h4 class="title">@Model.ProductName</h4>
                    <h4 class="price">@Model.Price.ToString("N0") đ</h4>
                    <p class="available">
                        Tình trạng:
                        <span class="text-muted">@(Model.Quantity > 0 ? $"Còn {Model.Quantity} sản phẩm" : "Hết hàng")</span>
                    </p>

                    @if (Model.Quantity > 0)
                    {
                        <form asp-controller="Cart" asp-action="Add" method="post" class="cart clearfix mb-50 d-flex">
                            <input type="hidden" name="productId" value="@Model.ProductId" />
                            <div class="quantity">
                                <span class="qty-minus"><i class="fa fa-minus" aria-hidden="true"></i></span>
                                <input type="number" class="qty-text" id="qty" name="quantity" step="1" min="1" max="@Model.Quantity" value="1">
                                <span class="qty-plus"><i class="fa fa-plus" aria-hidden="true"></i></span>
                            </div>
                            <button type="submit" class="btn cart-submit d-block">Thêm vào giỏ</button>
                        </form>
                    }

                    <div class="phone-desc">
                        <h6>Thông tin sản phẩm</h6>
                        <p>@Model.Description</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>