@model List<Catalog_And_Order_Sys.Models.CartItem>
@using System.Linq
@{
    ViewData["Title"] = "Giỏ hàng";
    decimal total = Model.Sum(i => i.TotalPrice);
}

<div class="cart_area section_padding_100 clearfix">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="cart-table clearfix">
                    <table class="table table-responsive">
                        <thead>
                            <tr>
                                <th>Sản phẩm</th>
                                <th>Đơn giá</th>
                                <th>Số lượng</th>
                                <th>Thành tiền</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="cart_product_img d-flex align-items-center">
                                        <a asp-controller="Product" asp-action="Details" asp-route-id="@item.ProductId">
                                            <img src="@(item.ImageUrl ?? "/img/product-img/product-1.jpg")" alt="@item.ProductName">
                                        </a>
                                        <h6>@item.ProductName</h6>
                                    </td>
                                    <td class="price"><span>@item.Price.ToString("N0") đ</span></td>
                                    <td class="qty">
                                        <form asp-controller="Cart" asp-action="Update" method="post" class="d-flex">
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <div class="quantity">
                                                <input type="number" class="qty-text" step="1" min="1" max="99"
                                                       name="quantity" value="@item.Quantity"
                                                       onchange="this.form.submit()">
                                            </div>
                                        </form>
                                    </td>
                                    <td class="total_price"><span>@item.TotalPrice.ToString("N0") đ</span></td>
                                    <td>
                                        <a asp-controller="Cart" asp-action="Remove" asp-route-id="@item.ProductId" title="Xóa">
                                            <i class="fa fa-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                            @if (!Model.Any())
                            {
                                <tr><td colspan="5" class="text-center">Giỏ hàng đang trống.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="cart-footer d-flex mt-30">
                    <div class="back-to-shop w-50">
                        <a asp-controller="Shop" asp-action="Index">Tiếp tục mua sắm</a>
                    </div>
                    <div class="update-checkout w-50 text-right">
                        <a asp-controller="Cart" asp-action="Clear">Xóa giỏ hàng</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12 col-lg-4 offset-lg-8">
                <div class="cart-total-area mt-70">
                    <div class="cart-page-heading">
                        <h5>Tổng giỏ hàng</h5>
                    </div>
                    <ul class="cart-total-chart">
                        <li><span>Tạm tính</span> <span>@total.ToString("N0") đ</span></li>
                        <li><span>Phí vận chuyển</span> <span>Miễn phí</span></li>
                        <li><span><strong>Tổng cộng</strong></span> <span><strong>@total.ToString("N0") đ</strong></span></li>
                    </ul>
                    @if (Model.Any())
                    {
                        <a asp-controller="Checkout" asp-action="Index" class="btn karl-checkout-btn">Tiến hành đặt hàng</a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>