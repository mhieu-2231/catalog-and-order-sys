@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>@ViewData["Title"] - MobileShop</title>
    <link rel="icon" href="~/img/core-img/favicon.ico">
    <link rel="stylesheet" href="~/css/core-style.css">
    <link rel="stylesheet" href="~/style.css">
    <link href="~/css/responsive.css" rel="stylesheet">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div id="wrapper">
        <!-- Header -->
        <header class="tg-header">
    <div class="tg-topstrip">
        <div class="container tg-flex">
            <span><i class="ti-check"></i> Hàng chính hãng 100% &nbsp;·&nbsp; Bảo hành 12 tháng</span>
            <span class="d-none d-md-inline"><i class="ti-truck"></i> Giao hàng toàn quốc &nbsp;·&nbsp; Đổi trả trong 7 ngày</span>
        </div>
    </div>

    <div class="tg-main">
        <div class="container tg-flex">
            <a asp-controller="Home" asp-action="Index" class="tg-logo">
                <i class="ti-mobile"></i> Mobile<b>Shop</b>
            </a>

            <form class="tg-search" asp-controller="Shop" asp-action="Index" method="get">
                <i class="ti-search tg-search-icon"></i>
                <input type="text" name="q" placeholder="Bạn tìm điện thoại nào?" value="@Context.Request.Query["q"]" autocomplete="off" />
                <button type="submit">Tìm</button>
            </form>

            @if (User.Identity?.IsAuthenticated == true)
{
    <div class="tg-dd tg-user">
        <a href="#" class="tg-action tg-dd-toggle">
            <i class="ti-user"></i>
            <span>@(User.IsInRole("Admin") ? "Quản trị" : "Tài khoản")</span>
            <i class="ti-angle-down tg-caret"></i>
        </a>
        <div class="tg-dd-panel">
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Category" asp-action="Index" class="tg-dd-item"><i class="ti-layout-grid2"></i> Danh mục</a>
                <a asp-controller="Product" asp-action="Index" class="tg-dd-item"><i class="ti-mobile"></i> Sản phẩm</a>
                <a asp-controller="Order" asp-action="Index" class="tg-dd-item"><i class="ti-shopping-cart"></i> Đơn hàng</a>
            }
            else
            {
                <div class="tg-dd-item" style="cursor:default;"><i class="ti-user"></i> @User.Identity.Name</div>
            }
            <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                <button type="submit" class="tg-dd-item tg-dd-btn"><i class="ti-power-off"></i> Đăng xuất</button>
            </form>
        </div>
    </div>
}
else
{
    <a asp-controller="Account" asp-action="Login" class="tg-action">
        <i class="ti-user"></i> <span>Đăng nhập</span>
    </a>
}

            <a asp-controller="Cart" asp-action="Index" class="tg-action">
                <i class="ti-bag"></i> <span>Giỏ hàng</span>
            </a>

            <a href="tel:0900000000" class="tg-action tg-hotline d-none d-lg-flex">
                <i class="ti-headphone-alt"></i>
                <span>Hotline<br><b>0900 000 000</b></span>
            </a>
        </div>
    </div>

    @await Component.InvokeAsync("CategoryMenu")
</header>

        @RenderBody()

        <!-- Footer -->
       <footer class="tg-footer">
    <div class="container">
        <div class="tg-footer-grid">
            <div class="tg-f-brand">
                <a asp-controller="Home" asp-action="Index" class="tg-f-logo">
                    <i class="ti-mobile"></i> Mobile<b>Shop</b>
                </a>
                <p>Điện thoại chính hãng, giá tốt mỗi ngày. Bảo hành 12 tháng, giao hàng toàn quốc.</p>
                <a href="tel:0900000000" class="tg-f-hotline">
                    <i class="ti-headphone-alt"></i>
                    <span>Tổng đài hỗ trợ<br><b>0900 000 000</b></span>
                </a>
            </div>

            <div>
                <h6>Mua sắm</h6>
                <ul>
                    <li><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                    <li><a asp-controller="Shop" asp-action="Index">Tất cả điện thoại</a></li>
                    <li><a asp-controller="Cart" asp-action="Index">Giỏ hàng</a></li>
                </ul>
            </div>

            <div>
                <h6>Cam kết</h6>
                <ul>
                    <li><i class="ti-check"></i> Hàng chính hãng 100%</li>
                    <li><i class="ti-check"></i> Bảo hành 12 tháng</li>
                    <li><i class="ti-check"></i> Đổi trả trong 7 ngày</li>
                    <li><i class="ti-check"></i> Giao hàng toàn quốc</li>
                </ul>
            </div>

            <div>
                <h6>Liên hệ</h6>
                <ul>
                    <li><i class="ti-email"></i> <a href="mailto:support@mobileshop.vn">support@mobileshop.vn</a></li>
                    <li><i class="ti-location-pin"></i> [Số nhà, đường, quận, thành phố]</li>
                    <li><i class="ti-time"></i> 8:00 – 21:00 hằng ngày</li>
                </ul>
            </div>
        </div>

        <div class="tg-f-bottom">
    <span>&copy; @DateTime.Now.Year MobileShop. Bảo lưu mọi quyền.</span>
    <span>
        Chính hãng · Bảo hành · Giao nhanh
        @if (!User.Identity!.IsAuthenticated)
        {
            <a asp-controller="Account" asp-action="Login" style="margin-left:12px;opacity:.6;">Quản trị</a>
        }
    </span>
</div>>
    </div>
</footer>
    </div>

    <script src="~/js/jquery/jquery-2.2.4.min.js"></script>
    <script src="~/js/popper.min.js"></script>
    <script src="~/js/bootstrap.min.js"></script>
    <script src="~/js/plugins.js"></script>
    <script src="~/js/active.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>