@model IEnumerable<Catalog_And_Order_Sys.Models.Category>
@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentCate = Context.Request.Query["categoryId"].ToString();
}

<nav class="tg-nav">
    <div class="container">
        <ul class="tg-menu">
            <!-- Nút danh mục (dropdown) -->
            <li class="tg-dd tg-dd-all">
                <a href="#" class="tg-dd-toggle"><i class="ti-menu"></i> Danh mục <i class="ti-angle-down tg-caret"></i></a>
                <div class="tg-dd-panel">
                    <a asp-controller="Shop" asp-action="Index" class="tg-dd-item @(ctrl == "Shop" && currentCate == "" ? "active" : "")">
                        <i class="ti-mobile"></i> Tất cả điện thoại
                    </a>
                    @foreach (var c in Model)
                    {
                        <a asp-controller="Shop" asp-action="Index" asp-route-categoryId="@c.CategoryId"
                           class="tg-dd-item @(currentCate == c.CategoryId.ToString() ? "active" : "")">
                            <i class="ti-angle-right"></i> @c.CategoryName
                        </a>
                    }
                </div>
            </li>

            <li class="@(ctrl == "Home" ? "active" : "")">
                <a asp-controller="Home" asp-action="Index"><i class="ti-home"></i> Trang chủ</a>
            </li>

            <!-- Hiển thị trực tiếp 6 hãng đầu tiên -->
            @foreach (var c in Model.Take(6))
            {
                <li class="@(currentCate == c.CategoryId.ToString() ? "active" : "")">
                    <a asp-controller="Shop" asp-action="Index" asp-route-categoryId="@c.CategoryId">@c.CategoryName</a>
                </li>
            }

            <!-- Nếu còn nhiều hãng hơn thì gom vào "Khác" -->
            @if (Model.Count() > 6)
            {
                <li class="tg-dd">
                    <a href="#" class="tg-dd-toggle">Khác <i class="ti-angle-down tg-caret"></i></a>
                    <div class="tg-dd-panel">
                        @foreach (var c in Model.Skip(6))
                        {
                            <a asp-controller="Shop" asp-action="Index" asp-route-categoryId="@c.CategoryId" class="tg-dd-item">
                                <i class="ti-angle-right"></i> @c.CategoryName
                            </a>
                        }
                    </div>
                </li>
            }

            
        </ul>
    </div>
</nav>

<script>
    // Mobile / cảm ứng: bấm để mở dropdown (desktop dùng hover bằng CSS)
    document.querySelectorAll('.tg-dd-toggle').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
            e.preventDefault();
            var li = btn.parentElement;
            var wasOpen = li.classList.contains('open');
            document.querySelectorAll('.tg-dd.open').forEach(function (x) { x.classList.remove('open'); });
            if (!wasOpen) li.classList.add('open');
        });
    });
    document.addEventListener('click', function (e) {
        if (!e.target.closest('.tg-dd')) {
            document.querySelectorAll('.tg-dd.open').forEach(function (x) { x.classList.remove('open'); });
        }
    });
</script>