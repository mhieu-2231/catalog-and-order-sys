<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - Quản trị MobileShop</title>
    <link href="~/admin/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/admin/css/metisMenu.min.css" rel="stylesheet">
    <link href="~/admin/css/timeline.css" rel="stylesheet">
    <link href="~/admin/css/startmin.css" rel="stylesheet">
    <link href="~/admin/css/morris.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet" type="text/css">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div id="wrapper">
        <nav class="navbar navbar-inverse navbar-fixed-top" role="navigation">
            <div class="navbar-header">
                <a class="navbar-brand" asp-controller="Admin" asp-action="Index">MobileShop Admin</a>
            </div>
            <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                <span class="sr-only">Toggle navigation</span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
            </button>

            <ul class="nav navbar-nav navbar-left navbar-top-links">
                <li><a asp-controller="Home" asp-action="Index"><i class="fa fa-home fa-fw"></i> Xem website</a></li>
            </ul>

            <ul class="nav navbar-right navbar-top-links">
                <li class="dropdown">
                    <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                        <i class="fa fa-user fa-fw"></i> @(User.Identity?.Name ?? "Admin") <b class="caret"></b>
                    </a>
                    <ul class="dropdown-menu dropdown-user">
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                                <button type="submit" class="btn btn-link" style="padding:3px 20px;width:100%;text-align:left;">
                                    <i class="fa fa-sign-out fa-fw"></i> Đăng xuất
                                </button>
                            </form>
                        </li>
                    </ul>
                </li>
            </ul>
        </nav>

        <aside class="sidebar navbar-default" role="navigation">
            <div class="sidebar-nav navbar-collapse">
                <ul class="nav" id="side-menu">
                    <li><a asp-controller="Admin" asp-action="Index"><i class="fa fa-dashboard fa-fw"></i> Tổng quan</a></li>
                    <li><a asp-controller="Category" asp-action="Index"><i class="fa fa-list fa-fw"></i> Hãng điện thoại</a></li>
                    <li><a asp-controller="Product" asp-action="Index"><i class="fa fa-mobile fa-fw"></i> Sản phẩm</a></li>
                    <li><a asp-controller="Order" asp-action="Index"><i class="fa fa-shopping-cart fa-fw"></i> Đơn hàng</a></li>
                </ul>
            </div>
        </aside>

        <div id="page-wrapper">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-lg-12">
                        <h1 class="page-header">@ViewData["Title"]</h1>
                    </div>
                </div>
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="~/admin/js/jquery.min.js"></script>
    <script src="~/admin/js/bootstrap.min.js"></script>
    <script src="~/admin/js/metisMenu.min.js"></script>
    <script src="~/admin/js/startmin.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>