@* =====================================================================
   Views/Shared/_AdminLayout.cshtml  (dùng cho toàn bộ trang Admin)
   Nguồn: cắt từ TEMPLATE.html (template Startmin)
   ===================================================================== *@
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>@ViewData["Title"] - Admin | Startmin</title>

    <link href="~/admin/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/admin/css/metisMenu.min.css" rel="stylesheet">
    <link href="~/admin/css/timeline.css" rel="stylesheet">
    <link href="~/admin/css/startmin.css" rel="stylesheet">
    <link href="~/admin/css/morris.css" rel="stylesheet">
    <link href="~/admin/css/font-awesome.min.css" rel="stylesheet" type="text/css">

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <div id="wrapper">

        <!-- Top Navigation -->
        <nav class="navbar navbar-inverse navbar-fixed-top" role="navigation">
            <div class="navbar-header">
                <a class="navbar-brand" asp-controller="Admin" asp-action="Index">Startmin</a>
            </div>

            <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                <span class="sr-only">Toggle navigation</span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
            </button>

            <ul class="nav navbar-nav navbar-left navbar-top-links">
                <li><a asp-controller="Home" asp-action="Index"><i class="fa fa-home fa-fw"></i> Website</a></li>
            </ul>

            <ul class="nav navbar-right navbar-top-links">
                <li class="dropdown">
                    <a class="dropdown-toggle" data-toggle="dropdown" href="#">
                        <i class="fa fa-user fa-fw"></i> @(User.Identity?.Name ?? "Admin") <b class="caret"></b>
                    </a>
                    <ul class="dropdown-menu dropdown-user">
                        <li><a href="#"><i class="fa fa-user fa-fw"></i> User Profile</a></li>
                        <li><a href="#"><i class="fa fa-gear fa-fw"></i> Settings</a></li>
                        <li class="divider"></li>
                        <li><a asp-controller="Account" asp-action="Logout"><i class="fa fa-sign-out fa-fw"></i> Logout</a></li>
                    </ul>
                </li>
            </ul>
        </nav>

        <!-- Sidebar -->
        <aside class="sidebar navbar-default" role="navigation">
            <div class="sidebar-nav navbar-collapse">
                <ul class="nav" id="side-menu">
                    <li>
                        <a asp-controller="Admin" asp-action="Index"><i class="fa fa-dashboard fa-fw"></i> Dashboard</a>
                    </li>
                    <li>
                        <a asp-controller="Category" asp-action="Index"><i class="fa fa-list fa-fw"></i> Danh mục</a>
                    </li>
                    <li>
                        <a asp-controller="Product" asp-action="Index"><i class="fa fa-cube fa-fw"></i> Sản phẩm</a>
                    </li>
                    <li>
                        <a asp-controller="Order" asp-action="Index"><i class="fa fa-shopping-cart fa-fw"></i> Đơn hàng</a>
                    </li>
                </ul>
            </div>
        </aside>

        <!-- Page Content -->
        <div id="page-wrapper">
            <div class="container-fluid">

                <div class="row">
                    <div class="col-lg-12">
                        <h1 class="page-header">@ViewData["Title"]</h1>
                    </div>
                </div>

                @RenderBody()

            </div>
        </div>

    </div>

    <script src="~/admin/js/jquery.min.js"></script>
    <script src="~/admin/js/bootstrap.min.js"></script>
    <script src="~/admin/js/metisMenu.min.js"></script>
    <script src="~/admin/js/startmin.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
