@model Catalog_And_Order_Sys.Models.Order
@{
    ViewData["Title"] = "Đặt hàng";
    var cart = ViewBag.Cart as List<Catalog_And_Order_Sys.Models.CartItem>;
    decimal total = ViewBag.Total;
}

<div class="checkout_area section_padding_100 clearfix">
    <div class="container">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <form asp-controller="Checkout" asp-action="Index" method="post">
            <div class="row">
                <div class="col-12 col-lg-7">
                    <div class="billing_details_area">
                        <h4>Thông tin nhận hàng</h4>
                        <div class="form-group">
                            <label asp-for="CustomerName">Họ tên</label>
                            <input asp-for="CustomerName" class="form-control" placeholder="Nguyễn Văn A" />
                            <span asp-validation-for="CustomerName" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="PhoneNumber">Số điện thoại</label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="09xxxxxxxx" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Address">Địa chỉ giao hàng</label>
                            <input asp-for="Address" class="form-control" placeholder="Số nhà, đường, quận/huyện, tỉnh/thành" />
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Note">Ghi chú (tuỳ chọn)</label>
                            <textarea asp-for="Note" class="form-control" rows="3"></textarea>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-5">
                    <div class="order_details_area">
                        <h4>Đơn hàng của bạn</h4>
                        <table class="table">
                            <thead>
                                <tr><th>Sản phẩm</th><th>SL</th><th>Thành tiền</th></tr>
                            </thead>
                            <tbody>
                                @if (cart != null)
                                {
                                    foreach (var item in cart)
                                    {
                                        <tr>
                                            <td>@item.ProductName</td>
                                            <td>@item.Quantity</td>
                                            <td>@item.TotalPrice.ToString("N0") đ</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="2"><strong>Tổng cộng</strong></td>
                                    <td><strong>@total.ToString("N0") đ</strong></td>
                                </tr>
                            </tfoot>
                        </table>
                        <button type="submit" class="btn karl-checkout-btn d-block">Đặt hàng</button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>