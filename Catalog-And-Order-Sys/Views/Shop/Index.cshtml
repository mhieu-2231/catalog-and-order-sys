@model IEnumerable<Catalog_And_Order_Sys.Models.Product>
@{
    ViewData["Title"] = "Điện thoại";
    var categories = ViewBag.Categories as IEnumerable<Catalog_And_Order_Sys.Models.Category>;
    int? selectedCategoryId = ViewBag.SelectedCategoryId;
}

<section class="shop_grid_area section_padding_100">
    <div class="container">
        <div class="row">
            <!-- Lọc theo hãng -->
            <div class="col-12 col-md-4 col-lg-3">
                <div class="shop_sidebar_area">
                    <div class="widget catagory mb-50">
                        <h6 class="phone-cate-title">Hãng điện thoại</h6>
                        <ul class="phone-cate-list">
                            <li class="@(selectedCategoryId == null ? "active" : "")">
                                <a asp-action="Index">Tất cả</a>
                            </li>
                            @if (categories != null)
                            {
                                foreach (var cate in categories)
                                {
                                    <li class="@(selectedCategoryId == cate.CategoryId ? "active" : "")">
                                        <a asp-action="Index" asp-route-categoryId="@cate.CategoryId">@cate.CategoryName</a>
                                    </li>
                                }
                            }
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Danh sách -->
            <div class="col-12 col-md-8 col-lg-9">
                <div class="shop_grid_product_area">
                    <div class="row">
                        @foreach (var product in Model)
                        {
                            <div class="col-12 col-sm-6 col-lg-4 single_gallery_item">
                                <div class="product-img">
                                    <img src="@(product.ImageUrl ?? "/img/product-img/product-1.jpg")" alt="@product.ProductName">
                                    <div class="product-quicview">
                                        <a asp-controller="Product" asp-action="Details" asp-route-id="@product.ProductId">
                                            <i class="ti-plus"></i>
                                        </a>
                                    </div>
                                </div>
                                <div class="product-description">
                                    <h4 class="product-price">@product.Price.ToString("N0") đ</h4>
                                    <p>@product.ProductName</p>
                                    <a asp-controller="Product" asp-action="Details" asp-route-id="@product.ProductId" class="add-to-cart-btn">XEM CHI TIẾT</a>
                                </div>
                            </div>
                        }
                        @if (!Model.Any())
                        {
                            <div class="col-12 text-center"><p>Không có sản phẩm nào trong danh mục này.</p></div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>