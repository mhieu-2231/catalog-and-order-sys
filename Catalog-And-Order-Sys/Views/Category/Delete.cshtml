@model Catalog_And_Order_Sys.Models.Category
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Xóa danh mục";
}

<div class="row">
    <div class="col-lg-6">
        <p>Bạn có chắc muốn xóa danh mục <strong>@Model.CategoryName</strong> không?</p>
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="CategoryId" />
            <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
            <a asp-action="Index" class="btn btn-default">Hủy</a>
        </form>
    </div>
</div>
