@model Catalog_And_Order_Sys.Models.Order
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"Đơn hàng #{Model.OrderId}";
    var statuses = new[] { "Chờ xử lý", "Đang giao", "Hoàn thành", "Đã hủy" };
}

<div class="row">
    <div class="col-lg-7">
        <h4>Thông tin khách hàng</h4>
        <table class="table table-bordered">
            <tr><th style="width:180px;">Họ tên</th><td>@Model.CustomerName</td></tr>
            <tr><th>Số điện thoại</th><td>@Model.PhoneNumber</td></tr>
            <tr><th>Địa chỉ</th><td>@Model.Address</td></tr>
            <tr><th>Ghi chú</th><td>@Model.Note</td></tr>
            <tr><th>Ngày đặt</th><td>@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</td></tr>
        </table>

        <h4>Chi tiết sản phẩm</h4>
        <table class="table table-bordered">
            <thead>
                <tr><th>Sản phẩm</th><th>Đơn giá</th><th>SL</th><th>Thành tiền</th></tr>
            </thead>
            <tbody>
                @foreach (var od in Model.OrderDetails)
                {
                    <tr>
                        <td>@od.Product?.ProductName</td>
                        <td>@od.UnitPrice.ToString("N0") đ</td>
                        <td>@od.Quantity</td>
                        <td>@((od.UnitPrice * od.Quantity).ToString("N0")) đ</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="3" class="text-right"><strong>Tổng cộng</strong></td>
                    <td><strong>@Model.TotalAmount.ToString("N0") đ</strong></td>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="col-lg-5">
        <h4>Cập nhật trạng thái</h4>
        <form asp-action="UpdateStatus" method="post">
            <input type="hidden" name="id" value="@Model.OrderId" />
            <div class="form-group">
                <select name="status" class="form-control">
                    @foreach (var s in statuses)
                    {
                        <option value="@s" selected="@(s == Model.Status)">@s</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-primary">Lưu trạng thái</button>
            <a asp-action="Index" class="btn btn-default">Quay lại danh sách</a>
        </form>
    </div>
</div>
